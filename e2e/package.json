{
  "name": "volunteer-connect-e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "guard": "tsx setup/guard.ts",
    "qa:migrate": "tsx setup/migrate.ts",
    "qa:seed": "tsx setup/seed.ts",
    "qa:teardown": "tsx setup/teardown.ts",
    "qa:dryrun": "tsx setup/dryrun.ts",
    "qa:first-run": "npm run qa:migrate && npm run qa:seed && npm test",
    "test": "playwright test",
    "test:ui": "playwright test --project=desktop-chromium --project=mobile-pixel7",
    "test:api": "playwright test --project=api",
    "report": "tsx setup/show-report.ts",
    "typecheck": "tsc --noEmit",
    "local:up": "tsx setup/local.ts up",
    "local:reset": "tsx setup/local.ts reset",
    "local:down": "tsx setup/local.ts down",
    "local:migrate": "E2E_TARGET=local tsx setup/migrate.ts",
    "local:seed": "E2E_TARGET=local tsx setup/seed.ts",
    "local:dryrun": "E2E_TARGET=local tsx setup/dryrun.ts",
    "local:test": "E2E_TARGET=local playwright test",
    "smoke": "playwright test --grep @smoke",
    "related": "node scripts/select-specs.mjs",
    "redact": "tsx setup/redact.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "^1.55.0",
    "@supabase/supabase-js": "^2.119.1",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.15.4",
    "dotenv": "^16.6.1",
    "pg": "^8.16.3",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
