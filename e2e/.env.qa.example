# Copy to e2e/.env.qa (git-ignored) and fill in the QA values.
# NEVER put production (kcxmjscxooqqhsgrhknb) values here: every script aborts if it sees them.

# --- QA Supabase project ---------------------------------------------------
SUPABASE_PROJECT_REF=impdbvwsaancutwlrmac
SUPABASE_URL=https://impdbvwsaancutwlrmac.supabase.co
# Dashboard > Project Settings > API Keys (publishable / anon key)
SUPABASE_PUBLISHABLE_KEY=
# Dashboard > Project Settings > API Keys (service_role / secret key). Server/Node only.
# The name must NOT start with VITE_, so it can never reach the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# --- Database access (only needed for `npm run qa:migrate`) ---------------
# Dashboard > Connect > "Session pooler" (port 5432, IPv4). Paste it WITHOUT the password:
SUPABASE_DB_POOLER_URL=postgresql://postgres.impdbvwsaancutwlrmac@aws-0-<region>.pooler.supabase.com:5432/postgres
# The database password; migrate.ts URL-encodes it and inserts it into the pooler URL at runtime.
SUPABASE_DB_PASSWORD=
# Optional: not required by `supabase db push --db-url`, kept for other Supabase CLI commands.
SUPABASE_ACCESS_TOKEN=

# --- Test users -------------------------------------------------------------
E2E_EMAIL_DOMAIN=dsvolunteer.test
# Shared password for every seeded and per-test user (min. 8 characters).
E2E_USER_PASSWORD=

# --- App under test -----------------------------------------------------------
# Port used by the e2e dev server (kept separate from your normal `vite dev` port).
BASE_URL=http://localhost:3100
